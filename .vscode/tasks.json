{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run current practical",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["${file}"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Verify all 23 practicals",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["${workspaceFolder}/verify_all.py"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}
